HOST=0.0.0.0
PORT=1337

# Secrets: replace all of these before deploying (any long random strings)
APP_KEYS=devKeyOne,devKeyTwo,devKeyThree,devKeyFour
API_TOKEN_SALT=devApiTokenSalt
ADMIN_JWT_SECRET=devAdminJwtSecret
TRANSFER_TOKEN_SALT=devTransferTokenSalt
ENCRYPTION_KEY=devEncryptionKey
JWT_SECRET=devJwtSecret

# Allowed frontend origins (comma separated). Add your Netlify/Vercel URL here after deploying.
CLIENT_URL=http://localhost:3000

# Database: sqlite (default) or postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true
