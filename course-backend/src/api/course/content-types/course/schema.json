{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": { "singularName": "course", "pluralName": "courses", "displayName": "Course" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "title": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "title", "required": true },
    "description": { "type": "text" },
    "price": { "type": "decimal", "default": 0, "min": 0 },
    "duration": { "type": "string" },
    "level": { "type": "enumeration", "enum": ["Beginner", "Intermediate", "Advanced"], "default": "Beginner" },
    "rating": { "type": "decimal", "default": 0, "min": 0, "max": 5 },
    "learners": { "type": "integer", "default": 0 },
    "instructor": { "type": "string" },
    "emoji": { "type": "string" },
    "theme": { "type": "enumeration", "enum": ["indigo", "cyan", "violet", "emerald", "pink", "amber", "sky", "slate"], "default": "indigo" },
    "modules": { "type": "json" },
    "thumbnail": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "category": { "type": "relation", "relation": "manyToOne", "target": "api::category.category", "inversedBy": "courses" }
  }
}
